# Copy to inventory.env and edit.

PROJECT_NAME=curling
DEPLOY_BASE=/home/USER/curling
SSH_KEY=
SSH_OPTS="-o StrictHostKeyChecking=no"

NODE1_HOST=10.0.0.11
NODE1_USER=USER
NODE1_ROLE=control

NODE2_HOST=10.0.0.12
NODE2_USER=USER
NODE2_ROLE=exchange

NODE3_HOST=10.0.0.13
NODE3_USER=USER
NODE3_ROLE=private

NODE4_HOST=10.0.0.14
NODE4_USER=USER
NODE4_ROLE=client

NODE5_HOST=10.0.0.15
NODE5_USER=USER
NODE5_ROLE=object-storage

NODE6_HOST=10.0.0.16
NODE6_USER=USER
NODE6_ROLE=queue

DB_NAME=rme
DB_USER=rme
DB_PASSWORD=rme_pass
DB_PORT=5432
API_PORT=8000
EXECUTOR_RPC_PORT=9008
PRIVATE_STORAGE_API_PORT=9010
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ELASTICMQ_PORT=9324

AWS_REGION=us-east-1
# Object store backend: minio or aws_s3.
# Use aws_s3 to omit S3_ENDPOINT_URL and let boto3 use AWS S3 plus ~/.aws/credentials.
OBJECT_STORE_BACKEND=minio
# Queue backend: elasticmq or aws_sqs.
# Use aws_sqs to omit SQS_ENDPOINT_URL and let boto3 use AWS SQS plus ~/.aws/credentials.
QUEUE_BACKEND=elasticmq
# Required when QUEUE_BACKEND=aws_sqs unless each queue URL is provided explicitly.
# AWS_ACCOUNT_ID=123456789012
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# MinIO credentials never belong in AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# Optional service credentials; default to MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
# MINIO_ACCESS_KEY_ID=minioadmin
# MINIO_SECRET_ACCESS_KEY=minioadmin
# Named AWS profile installed separately on each API/executor/admin node.
# AWS_PROFILE=curling
AWS_MAX_POOL_CONNECTIONS=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
S3_BUCKET_STAGED=exchange-staged
S3_BUCKET_RELEASED=exchange-released
SQS_QUEUE_NAME=request-queue

# Optional multi-private-storage domains.
# If unset, the project uses one default domain with the legacy bucket/queue names above.
# Domain-specific env var names use uppercase domain id with non-alphanumeric characters
# replaced by underscores. For example, "domain-a" becomes DOMAIN_DOMAIN_A_*.
# PRIVATE_DOMAINS="domain-a domain-b"
# DOMAIN_DOMAIN_A_PRIVATE_HOST=10.0.0.13
# DOMAIN_DOMAIN_A_QUEUE_HOST=10.0.0.16
# DOMAIN_DOMAIN_A_OBJECT_HOST=10.0.0.15
# DOMAIN_DOMAIN_A_QUEUE_NAME=request-queue-domain-a
# DOMAIN_DOMAIN_A_STAGED_BUCKET=exchange-staged-domain-a
# DOMAIN_DOMAIN_A_RELEASED_BUCKET=exchange-released-domain-a
# DOMAIN_DOMAIN_A_PRIVATE_BASE=${DEPLOY_BASE}/private-data-domain-a
# DOMAIN_DOMAIN_A_WORK_BASE=${DEPLOY_BASE}/work-domain-a
# DOMAIN_DOMAIN_B_PRIVATE_HOST=10.0.0.17
# DOMAIN_DOMAIN_B_QUEUE_HOST=10.0.0.16
# DOMAIN_DOMAIN_B_OBJECT_HOST=10.0.0.15
# DOMAIN_DOMAIN_B_QUEUE_NAME=request-queue-domain-b
# DOMAIN_DOMAIN_B_STAGED_BUCKET=exchange-staged-domain-b
# DOMAIN_DOMAIN_B_RELEASED_BUCKET=exchange-released-domain-b
# DOMAIN_DOMAIN_B_PRIVATE_BASE=${DEPLOY_BASE}/private-data-domain-b
# DOMAIN_DOMAIN_B_WORK_BASE=${DEPLOY_BASE}/work-domain-b
API_LOG_ENABLED=true
EXECUTOR_LOG_ENABLED=true
# Independent diagnostic JSON logs, including empty receives and a heartbeat.
EXECUTOR_DIAGNOSTICS_ENABLED=false
EXECUTOR_DIAGNOSTICS_INTERVAL_SECONDS=1
EXECUTOR_SCHEDULER_MODE=reuse
EXECUTOR_STAGING_ENABLED=false
EXECUTOR_WORKER_COUNT=1
EXECUTOR_NOOP_ENABLED=false
EXECUTOR_INFLIGHT_REUSE_ENABLED=true
EXECUTOR_MIN_BACKOFF_SECONDS=0.01
EXECUTOR_MAX_BACKOFF_SECONDS=1.0
EXECUTOR_SCHEDULER_BATCH_SIZE=1
EXECUTOR_SCHEDULER_BATCH_WAIT_SECONDS=0.02
REQUEST_EXECUTION_MODE=executor_rpc
EXECUTOR_RPC_TIMEOUT_SECONDS=300
PRIVATE_STORAGE_API_TIMEOUT_SECONDS=300
